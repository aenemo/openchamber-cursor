{
  "name": "openchamber-cursor",
  "version": "0.1.0",
  "description": "OpenCode V2 plugin that uses a Cursor subscription from OpenChamber and other OpenCode hosts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aenemo/openchamber-cursor.git"
  },
  "bugs": "https://github.com/aenemo/openchamber-cursor/issues",
  "homepage": "https://github.com/aenemo/openchamber-cursor#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime.mjs",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "openchamber",
    "cursor"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.5",
    "@cursor/sdk": "1.2.0",
    "@opencode/plugin": "2.1.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
